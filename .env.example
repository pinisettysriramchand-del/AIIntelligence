# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=StratIQ
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://stratiq:stratiq@localhost:5432/stratiq

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=stratiq_chunks

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=/tmp/stratiq_storage

# ── OpenAI-compatible LLM & Embeddings ───────────────────────────────────────
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── OpenTelemetry (optional) ──────────────────────────────────────────────────
# Enable with a collector: docker compose --profile otel up
OTEL_ENABLED=false
OTEL_SERVICE_NAME=stratiq-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_RATIO=1.0
